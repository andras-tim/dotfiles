#!/usr/bin/env python3
"""Print how many KeePass entries match each URL, as '<count><TAB><url>' lines.

Uses the KeePassHTTP 'get-logins-count' request only: credentials never leave
KeePass, so the tool is safe to hand to an agent. Normal runs never trigger a
KeePass dialog; '--associate' (one-time, interactive) is the only exception.

Exit codes: 0 = counts printed, 2 = KeePass unreachable, locked or not associated.
"""

import argparse
import base64
import sys

import keyring
import requests
from Cryptodome.Cipher import AES
from Cryptodome.Random import get_random_bytes
from Cryptodome.Util.Padding import pad

KEEPASSHTTP_URL = 'http://localhost:19455'
# Own association, so it can be reviewed / revoked in KeePass apart from tia-get-credentials
KEYRING_SERVICE = 'keepasshttplib-tia-has-credentials'


class KeePassError(Exception):
    pass


def main():
    args = parse_args()
    try:
        if args.associate:
            associate()
            return

        key, connection_id = load_association()
        urls = args.url or [line.strip() for line in sys.stdin if line.strip()]
        for url in urls:
            print('{}\t{}'.format(count_logins(key, connection_id, url), url))
    except KeePassError as e:
        print('error: {}'.format(e), file=sys.stderr)
        sys.exit(2)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--associate', action='store_true',
                        help='pair with KeePass once (confirm the dialog in KeePass)')
    parser.add_argument('url', nargs='*', help='URLs to check; read from stdin (one per line) when omitted')
    return parser.parse_args()


def associate():
    key = get_random_bytes(32)
    _, auth = _auth(key)
    data = _post(dict(auth, RequestType='associate', Key=base64.b64encode(key).decode()))
    if not data.get('Success'):
        raise KeePassError('association rejected in KeePass')
    keyring.set_password(KEYRING_SERVICE, 'connection_id', data['Id'])
    keyring.set_password(KEYRING_SERVICE, 'private_key', base64.b64encode(key).decode())


def load_association():
    hint = 'ask the user to unlock KeePass or run: tia-has-credentials --associate'
    private_key = keyring.get_password(KEYRING_SERVICE, 'private_key')
    connection_id = keyring.get_password(KEYRING_SERVICE, 'connection_id')
    if private_key is None or connection_id is None:
        raise KeePassError('not associated; {}'.format(hint))

    key = base64.b64decode(private_key)
    _, auth = _auth(key)
    data = _post(dict(auth, RequestType='test-associate', TriggerUnlock='false', Id=connection_id))
    if not data.get('Success'):
        raise KeePassError('KeePass is locked or the association was revoked; {}'.format(hint))
    return key, connection_id


def count_logins(key: bytes, connection_id: str, url: str) -> int:
    iv, auth = _auth(key)
    encrypted_url = _encrypt(key, iv, url)
    data = _post(dict(auth, RequestType='get-logins-count', TriggerUnlock='false', Id=connection_id,
                      Url=encrypted_url, SubmitUrl=encrypted_url))
    if not data.get('Success'):
        raise KeePassError('lookup failed for {!r}'.format(url))
    return int(data['Count'])


def _auth(key: bytes):
    """Fresh nonce + verifier; KeePassHTTP expects the request's fields encrypted with the same IV."""
    iv = get_random_bytes(16)
    nonce = base64.b64encode(iv).decode()
    return iv, {'Nonce': nonce, 'Verifier': _encrypt(key, iv, nonce)}


def _encrypt(key: bytes, iv: bytes, plain: str) -> str:
    return base64.b64encode(AES.new(key, AES.MODE_CBC, iv).encrypt(pad(plain.encode(), AES.block_size))).decode()


def _post(payload: dict) -> dict:
    try:
        data = requests.post(KEEPASSHTTP_URL, json=payload, timeout=10).json()
    except (requests.RequestException, ValueError) as e:
        raise KeePassError('KeePassHTTP not reachable at {}: {}'.format(KEEPASSHTTP_URL, e))
    if data.get('Error'):
        raise KeePassError(data['Error'])
    return data


if __name__ == '__main__':
    main()
