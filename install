#!/usr/bin/env python3

import argparse
import subprocess
from pathlib import Path

DEFAULT_CONFIG = 'default'
CONFIG_SUFFIX = '.conf.yaml'

BASE_DIR = Path(__file__).parent.absolute()
DOTBOT_DIR = BASE_DIR.joinpath('vendor', 'dotbot')
DOTBOT_BIN = DOTBOT_DIR.joinpath('bin', 'dotbot')


def main():
    parameters, configs = get_arguments()

    setup_submodules()
    for config in [DEFAULT_CONFIG] + configs:
        run(str(DOTBOT_BIN), *parameters, '-d', str(BASE_DIR), '-c', '{}{}'.format(config, CONFIG_SUFFIX))


def get_arguments() -> tuple:
    parser = argparse.ArgumentParser(description='Install the dotfiles with dotbot. Unknown options are passed to dotbot.',
                                     allow_abbrev=False)
    parser.add_argument('configs', nargs='*', help='profiles to install after the default one, e.g. desktop, termux')
    args, parameters = parser.parse_known_intermixed_args()

    return parameters, args.configs


def setup_submodules():
    # The submodules follow the dotfiles clone: shallow or full. --depth 1, because "shallow = true" alone fetches
    # the full history of a submodule pinned below its branch tip (e.g. dotbot on a release tag).
    shallow = get_output('git', 'rev-parse', '--is-shallow-repository') == ['true']
    run('git', 'submodule', 'update', '--init', '--recursive', *(['--depth', '1'] if shallow else ['--no-recommend-shallow']))


def get_output(*command: str) -> list:
    try:
        return subprocess.check_output(command, cwd=str(BASE_DIR), universal_newlines=True).splitlines()
    except subprocess.CalledProcessError as e:
        exit(e.returncode)


def run(*command: str):
    try:
        subprocess.check_call(command, cwd=str(BASE_DIR))
    except subprocess.CalledProcessError as e:
        exit(e.returncode)


if __name__ == '__main__':
    main()
