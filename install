#!/usr/bin/env python3

# Keep this script runnable on old hosts (Python 3.2, git 1.7.9): they get the submodules and a clear error
# instead of a SyntaxError, because dotbot itself needs a newer Python.

import argparse
import os
import re
import subprocess
import sys

DEFAULT_CONFIG = 'default'
CONFIG_SUFFIX = '.conf.yaml'
DOTBOT_MIN_PYTHON = (3, 7)

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DOTBOT_BIN = os.path.join(BASE_DIR, 'vendor', 'dotbot', 'bin', 'dotbot')
# Further dotfiles dirs of the host, one path per line: a profile of theirs runs after the same profile of this repo
DIRS_FILE = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser(os.path.join('~', '.config')),
                         'dotfiles', 'dirs')


def main():
    if sys.version_info < DOTBOT_MIN_PYTHON:
        setup_submodules()
        sys.exit('dotbot needs Python {}.{}+, this is {}.{}: the submodules are set up, link the dotfiles by hand'.format(
            *(DOTBOT_MIN_PYTHON + sys.version_info[:2])))

    parameters, configs = get_arguments()

    setup_submodules()
    dirs = [BASE_DIR] + get_extra_dirs()
    for config in [DEFAULT_CONFIG] + configs:
        candidates = (os.path.join(d, config + CONFIG_SUFFIX) for d in dirs)
        config_files = [path for path in candidates if os.path.exists(path)]
        if not config_files:
            sys.exit('Unknown profile: {}'.format(config))
        for config_file in config_files:
            run(*([DOTBOT_BIN] + parameters + ['-d', os.path.dirname(config_file), '-c', config_file]))


def get_extra_dirs() -> list:
    if not os.path.exists(DIRS_FILE):
        return []
    with open(DIRS_FILE) as f:
        lines = [line.strip() for line in f]
    dirs = [os.path.abspath(os.path.expanduser(line)) for line in lines if line and not line.startswith('#')]
    missing = [d for d in dirs if not os.path.isdir(d)]
    if missing:
        sys.exit('Missing dotfiles dir in {}: {}'.format(DIRS_FILE, ', '.join(missing)))
    return [d for d in dirs if d != BASE_DIR]


def get_arguments() -> tuple:
    parser = argparse.ArgumentParser(description='Install the dotfiles with dotbot. Unknown options are passed to dotbot.',
                                     allow_abbrev=False)
    parser.add_argument('configs', nargs='*', help='profiles to install after the default one, e.g. desktop, termux')
    args, parameters = parser.parse_known_intermixed_args()

    return parameters, args.configs


def setup_submodules():
    # The submodules follow the dotfiles clone: shallow or full. --depth 1, because "shallow = true" alone fetches
    # the full history of a submodule pinned below its branch tip (e.g. dotbot on a release tag).
    # git < 2.10 has neither option and clones the submodules in full.
    options = []
    if get_git_version() >= (2, 10):
        options = ['--depth', '1'] if is_shallow_clone() else ['--no-recommend-shallow']
    run(*(['git', 'submodule', 'update', '--init', '--recursive'] + options))


def get_git_version() -> tuple:
    version = re.search(r'(\d+)\.(\d+)', get_output('git', '--version')[0])
    return tuple(int(part) for part in version.groups())


def is_shallow_clone() -> bool:
    # Same check as "git rev-parse --is-shallow-repository" (git 2.15+)
    return os.path.exists(os.path.join(BASE_DIR, get_output('git', 'rev-parse', '--git-dir')[0], 'shallow'))


def get_output(*command: str) -> list:
    try:
        return subprocess.check_output(command, cwd=BASE_DIR, universal_newlines=True).splitlines()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


def run(*command: str):
    try:
        subprocess.check_call(command, cwd=BASE_DIR)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


if __name__ == '__main__':
    main()
